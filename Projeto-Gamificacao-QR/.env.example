# Aplicação
APP_NAME=Gamificação QR - Evento IFMT
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
EVENT_TIMEZONE=America/Cuiaba
LOG_LEVEL=INFO

# Supabase — secret key somente no backend
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA

# Sessão de participante
PARTICIPANT_COOKIE_NAME=event_session
PARTICIPANT_SESSION_DAYS=30
SESSION_COOKIE_SECURE=false

# Administração
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria
ADMIN_COOKIE_NAME=event_admin
ADMIN_SESSION_HOURS=12

# Moderação adicional, termos separados por vírgula
BLOCKED_NICK_TERMS=
